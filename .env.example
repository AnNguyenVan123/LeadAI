# Backend (Railway)
ANTHROPIC_API_KEY=sk-ant-...        # bắt buộc — không có thì không chạy được trên server
LEADAI_DB=/data/leadai.db           # trỏ vào volume của Railway, nếu không dữ liệu mất mỗi lần deploy
LEADAI_ORIGINS=https://your-app.vercel.app
LEADAI_MAX_RUNS_PER_IP=2
LEADAI_MAX_RUNS_PER_DAY=60
LEADAI_ALLOW_LIVE=0                 # bật thành 1 nếu muốn cho quét Reddit trực tiếp
LEADAI_QUALIFY_TOP=8                # số post đưa qua Opus mỗi lượt — đây là nút vặn chi phí
REDDIT_CLIENT_ID=                   # chỉ cần khi bật LEADAI_ALLOW_LIVE
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=leadai-radar/0.1

# Frontend (Vercel)
NEXT_PUBLIC_API_BASE=https://your-api.up.railway.app
